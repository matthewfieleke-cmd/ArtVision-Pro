# --- Server (Vercel / local dev API) — NEVER commit real keys ---
OPENAI_API_KEY=
# Optional: chat + style classify (default gpt-6-astra)
# OPENAI_MODEL=gpt-6-astra
# Critique only (optional; overrides OPENAI_MODEL for /api/critique)
# OPENAI_CRITIQUE_MODEL=gpt-6-astra
# Stage-specific critique models (optional; each falls back to OPENAI_CRITIQUE_MODEL, then OPENAI_MODEL)
# OPENAI_MODEL_CLASSIFY=gpt-6-astra
# OPENAI_MODEL_EVIDENCE=gpt-6-astra
# OPENAI_MODEL_CALIBRATION=gpt-6-astra
# OPENAI_MODEL_WRITE=gpt-6-astra
# OPENAI_MODEL_VALIDATE=gpt-6-astra
# OPENAI_MODEL_FALLBACK=gpt-6-astra
# OPENAI_MODEL_CLARITY=gpt-6-astra

# Global reasoning_effort ceiling (low | medium | high | xhigh | max) for gpt-5 / gpt-6 / o-series.
# Per-stage defaults stay low (vision/synthesis/classify) and medium (writers) for speed.
# Prefer leaving this unset; a high/max ceiling slows every stage.
# Non-reasoning chat models (gpt-4o, gpt-5-chat-latest) ignore this and keep using temperature.
# OPENAI_REASONING_EFFORT=medium

# Image edit preview (Phase 1) — default gpt-image-2.5-sunburst. Quality defaults to medium for speed.
# gpt-image-2.5-sunburst also accepts xhigh and max (slower). Prefer medium or high in production.
# Candidate count defaults to 1 so AI edits return as fast as possible; set OPENAI_IMAGE_EDIT_CANDIDATES to
# 2-4 to generate multiple candidates in parallel and pick the best-ranked one (slower, better quality).
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_EDIT_QUALITY=medium
# OPENAI_IMAGE_EDIT_CANDIDATES=1

# Optional: Stripe pay-per-use ($1.49 / critique, $0.99 / AI preview). When all three are set, paid routes require checkout.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_CHECKOUT_JWT_SECRET=  # random 32+ chars; signs short-lived tokens after Checkout
# STRIPE_CHECKOUT_ORIGIN=https://your-app.vercel.app  # public site URL (no trailing slash); required for checkout-return redirect

# --- Frontend (Vite) — safe to expose ---
# GitHub project Pages build: must match the URL path, e.g. /ArtVision-Pro/
# (The included GitHub Action sets this from the repo name.)
# VITE_BASE=/

# Production API origin (no trailing slash), e.g. https://your-api.vercel.app
# Required on GitHub Pages for OpenAI critique (Pages has no serverless API).
# VITE_CRITIQUE_API_URL=

# Local dev: `npm run dev` starts API + Vite (full mode). Use `npm run dev:ui` for Vite only.

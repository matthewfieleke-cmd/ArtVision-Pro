# --- Server (Vercel / local dev API) — NEVER commit real keys ---
OPENAI_API_KEY=

# =============================================================================
# COPY THIS INTO Vercel → Project → Settings → Environment Variables
# (Production + Preview). Then Deployments → ⋮ → Redeploy.
#
# Plan: Vercel Pro (300s). Hobby still kills critiques at ~60s.
# =============================================================================
#
# SET EXACTLY (Key = Value):
#
#   OPENAI_API_KEY                 = sk-...your key...
#   OPENAI_MODEL                   = gpt-6-astra
#   OPENAI_MODEL_EVIDENCE          = gpt-6-astra
#   OPENAI_MODEL_WRITE             = gpt-5.4
#   OPENAI_MODEL_VALIDATE          = gpt-6-astra
#   OPENAI_IMAGE_EDIT_MODEL        = gpt-image-2.5-sunburst
#   OPENAI_IMAGE_EDIT_QUALITY      = high
#   OPENAI_CLARITY_PASS            = true
#
# DELETE / leave blank if present (these break quality or force timeouts):
#
#   OPENAI_CRITIQUE_MODEL          ← DELETE (legacy; used to force all stages)
#   OPENAI_REASONING_EFFORT        ← DELETE (would cap writers down from medium)
#   OPENAI_MODEL_CLASSIFY          ← optional; omit so it inherits OPENAI_MODEL
#   OPENAI_SKIP_ANCHOR_REGION_REFINE ← omit (keep anchor refine on for quality)
#
# What you get:
#   Looking (style + observation bank)  → gpt-6-astra @ medium effort
#   8 parallel criterion writers        → gpt-5.4 @ medium effort  ← critical path
#   Synthesis rollup                    → gpt-6-astra @ medium effort
#   Clarity polish pass                 → on
#   AI preview edits                    → gpt-image-2.5-sunburst @ high
#
# ONLY after a hybrid critique finishes reliably on Pro (often <90s), you may
# try max writer quality by changing ONE var:
#
#   OPENAI_MODEL_WRITE             = gpt-6-astra
#
# If that times out, set WRITE back to gpt-5.4 immediately.
# =============================================================================

# Local mirrors of the recommended Vercel values (uncomment for `npm run dev`):
# OPENAI_MODEL=gpt-6-astra
# OPENAI_MODEL_EVIDENCE=gpt-6-astra
# OPENAI_MODEL_WRITE=gpt-5.4
# OPENAI_MODEL_VALIDATE=gpt-6-astra
# OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_EDIT_QUALITY=high
# OPENAI_CLARITY_PASS=true
# OPENAI_IMAGE_EDIT_CANDIDATES=1

# Optional: Stripe pay-per-use ($1.49 / critique, $0.99 / AI preview). When all three are set, paid routes require checkout.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_CHECKOUT_JWT_SECRET=  # random 32+ chars; signs short-lived tokens after Checkout
# STRIPE_CHECKOUT_ORIGIN=https://your-app.vercel.app  # public site URL (no trailing slash); required for checkout-return redirect

# --- Frontend (Vite) — safe to expose ---
# GitHub project Pages build: must match the URL path, e.g. /ArtVision-Pro/
# (The included GitHub Action sets this from the repo name.)
# VITE_BASE=/

# Production API origin (no trailing slash), e.g. https://your-api.vercel.app
# Required on GitHub Pages for OpenAI critique (Pages has no serverless API).
# VITE_CRITIQUE_API_URL=

# Local dev: `npm run dev` starts API + Vite (full mode). Use `npm run dev:ui` for Vite only.

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/critique.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/preview-edit.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "api/classify-style.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/classify-medium.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
